# ── Application ─────────────────────────────────────────────
PORT=4001
NODE_ENV=development
CORS_ORIGINS=*

# ── Database (Neon Tech Serverless PostgreSQL) ──────────────────────
# The Pooled connection string (with ?pgbouncer=true) for app connections
DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.neon.tech/<dbname>?schema=public&sslmode=require&pgbouncer=true"

# The Direct connection string for Prisma migrations
DIRECT_URL="postgresql://<user>:<password>@<endpoint>.neon.tech/<dbname>?schema=public&sslmode=require"

# ── Redis 7 ─────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=              # Leave empty for Docker local dev (no requirepass configured)

# ── Auth / JWT ───────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-to-a-strong-random-secret
JWT_ACCESS_EXPIRES_IN=15m
