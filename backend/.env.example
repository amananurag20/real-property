# ── Application ─────────────────────────────────────────────
PORT=4001
NODE_ENV=development
CORS_ORIGINS=*

# ── Database (PostgreSQL 15) ────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=max_shipping

# Prisma connection string (built from the vars above)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/max_shipping?schema=public

# ── Redis 7 ─────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=              # Leave empty for Docker local dev (no requirepass configured)

# ── Auth / JWT ───────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-to-a-strong-random-secret
JWT_ACCESS_EXPIRES_IN=15m
